# Copy this file to native.env and edit values for the target ARM64 system.
# native.env is intentionally ignored by Git.

NATIVE_HOST=host
NATIVE_USER=user
NATIVE_SSH_PORT=22
# Optional dedicated key when the default SSH identity is not accepted.
NATIVE_IDENTITY_FILE=
NATIVE_UNAME_ARCH=aarch64
NATIVE_DEB_ARCH=arm64
NATIVE_OS=debian13

VINS_CONFIG=/etc/vins-neo/iVIN.yaml
DATASET=/home/rpi/TestDeploy/data
OUTPUT_DIR=/home/rpi/vins-neo-release
DATASET_TEST_RUNNER=/home/rpi/tools/vins_test/vins_test.py

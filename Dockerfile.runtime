ARG DEBIAN_SUITE=trixie
FROM debian:${DEBIAN_SUITE}-slim

ARG IROS_VERSION=0.1.1
ARG IROS_DEB_VERSION=0.1.1-1+deb13
ARG IROS_SHA256=62ef93734ae588cb5f342e902556d4cfa7b21de071bfedfe5b72c5431e42fe25
ARG VINS_VERSION=1.0.1.7
ARG VINS_TAG=v1_00_01_07
ARG VINS_SHA256=eef16d7eab2795cde5ab37501efe00f7400edaab2451039657118367e686b376

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    ROS_DISTRO=jazzy

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY docker/runtime-entrypoint.sh /usr/local/bin/vins-runtime-entrypoint

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && iros_package="iros2-0_${IROS_DEB_VERSION}_arm64.deb" \
    && curl -fL \
        "https://github.com/Drone-Age/iros2_0/releases/download/v${IROS_VERSION}/${iros_package}" \
        -o "/tmp/${iros_package}" \
    && echo "${IROS_SHA256}  /tmp/${iros_package}" | sha256sum -c - \
    && apt-get install -y --no-install-recommends "/tmp/${iros_package}" \
    && vins_package="vins-mono-ros2_${VINS_VERSION}_arm64.deb" \
    && curl -fL \
        "https://github.com/Drone-Age/VINS-NEO/releases/download/${VINS_TAG}/${vins_package}" \
        -o "/tmp/${vins_package}" \
    && echo "${VINS_SHA256}  /tmp/${vins_package}" | sha256sum -c - \
    && apt-get install -y --no-install-recommends "/tmp/${vins_package}" \
    && test "$(dpkg-query -W -f='${Version}' iros2-0)" = "${IROS_DEB_VERSION}" \
    && test "$(dpkg-query -W -f='${Version}' vins-mono-ros2)" = "${VINS_VERSION}" \
    && chmod 0755 /usr/local/bin/vins-runtime-entrypoint \
    && rm -f "/tmp/${iros_package}" "/tmp/${vins_package}" \
    && rm -rf /var/lib/apt/lists/*

ENTRYPOINT ["/usr/local/bin/vins-runtime-entrypoint"]
CMD ["bash"]
